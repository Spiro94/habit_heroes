  "version": "0.2.0",
  "configurations": [
    {
      "name": "development (debug)",
      "cwd": "app",
      "request": "launch",
      "type": "dart",
      "program": "lib/app/configurations/development.dart",
      "args": [
        "--target",
        "lib/app/configurations/development.dart",
        "--flavor",
        "dev"
      ]
    },
    {
      "name": "development (release)",
      "cwd": "app",
      "request": "launch",
      "type": "dart",
      "flutterMode": "release",
      "program": "lib/app/configurations/development.dart",
      "args": [
        "--target",
        "lib/app/configurations/development.dart",
        "--flavor",
        "dev"
      ]
    },
    {
      "name": "production (debug)",
      "cwd": "app",
      "request": "launch",
      "type": "dart",
      "program": "lib/app/configurations/production.dart",
      "args": [
        "--target",
        "lib/app/configurations/production.dart",
        "--flavor",
        "production",
      ]
    },
    {
      "name": "Account Deletion Web (Chrome)",
      "cwd": "app",
      "request": "launch",
      "type": "dart",
      "program": "lib/main_web_account_deletion.dart",
      "deviceId": "chrome",
    }
  ]
}